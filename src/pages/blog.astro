---
import { openGraph } from "spectre:globals";
import LogEntry from "../components/LogEntry.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../utils/content";

const posts = await getPosts();
const tags = [
	...new Set(posts.flatMap((p) => p.data.tags.map((t) => t.id))),
].sort();
---

<Layout title={openGraph.blog.title || "Writing"} description={openGraph.blog.description} pagefindIgnore>
	<div class="wrap">
		<header class="page-head">
			<p class="label label--accent">[01] Logbook · {posts.length} {posts.length === 1 ? "entry" : "entries"}</p>
			<h1 class="page-title">Writing.</h1>
			<p class="page-lede">Long-form write-ups. What I opened, what was inside, what broke.</p>
		</header>

		{
			tags.length > 1 && (
				<div class="filters" role="group" aria-label="Filter by subject">
					<span class="label">Filter</span>
					{tags.map((tag) => (
						<button type="button" class="filter" data-tag={tag} aria-pressed="false">
							{tag}
						</button>
					))}
				</div>
			)
		}

		<div class="entries">
			{posts.length > 0 ? posts.map((post) => <LogEntry post={post} />) : <p class="empty">First entry is being written.</p>}
		</div>
	</div>
</Layout>

<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>(".filter")];
	const entries = [...document.querySelectorAll<HTMLAnchorElement>(".entries .entry")];
	const selected = new Set(new URL(location.href).searchParams.get("tags")?.split(",").filter(Boolean) ?? []);

	function apply() {
		for (const b of buttons) b.setAttribute("aria-pressed", String(selected.has(b.dataset.tag!)));
		for (const e of entries) {
			const tags = (e.dataset.tags ?? "").split(",");
			e.hidden = selected.size > 0 && ![...selected].every((t) => tags.includes(t));
		}
		const url = new URL(location.pathname, location.origin);
		if (selected.size > 0) url.searchParams.set("tags", [...selected].join(","));
		history.replaceState(null, "", url);
	}

	for (const b of buttons) {
		b.addEventListener("click", () => {
			const tag = b.dataset.tag!;
			selected.has(tag) ? selected.delete(tag) : selected.add(tag);
			apply();
		});
	}

	apply();
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding-block: 24px;
	}

	.filters .label {
		margin-right: 8px;
	}

	.filter {
		min-height: 36px;
		padding: 0 12px;
		border: 1px solid var(--rule);
		background: transparent;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
		cursor: pointer;
	}

	@media (hover: hover) and (pointer: fine) {
		.filter:hover {
			color: var(--text);
		}
	}

	.filter:active {
		border-color: var(--muted);
	}

	.filter[aria-pressed="true"] {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}

	.entries {
		padding-top: 24px;
	}

	.empty {
		padding-block: 24px;
		border-block: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--muted);
	}
</style>
