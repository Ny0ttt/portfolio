---
import "../../styles/prose.css";

import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import MetaGrid from "../../components/MetaGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../utils/content";
import { base } from "../../utils/url";

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { project: project.id },
		props: { project },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { Content } = await render(project);

// `info` entries carry an icon but no label; the icon says what kind of fact it is.
const labelFor: Record<string, string> = {
	layers: "Stack",
	"check-circle": "Result",
	"graduation-cap": "Context",
	network: "Architecture",
	"code-2": "Status",
	smartphone: "Platform",
	monitor: "Platform",
	github: "Source",
};

const meta = [
	{ label: "Year", value: String(project.data.date.getFullYear()) },
	...project.data.info.map((item) => ({
		label: labelFor[item.icon.name as string] ?? "Note",
		value: item.text,
		href: item.link,
	})),
	...(project.data.link
		? [{ label: "Live", value: "Open ↗", href: project.data.link }]
		: []),
];
---

<Layout
	title={project.data.title}
	description={project.data.description}
	image={project.data.image}
	article={{ createdAt: project.data.date }}
>
	<article class="wrap" data-pagefind-body>
		<header class="page-head" id="_top" data-pagefind-ignore>
			<p class="label label--accent">{project.buildId} · {project.data.date.getFullYear()}</p>
			<h1 class="page-title">{project.data.title}</h1>
			<p class="page-lede">{project.data.description}</p>
			<MetaGrid items={meta} min={180} class="project-meta" />
		</header>

		<div class="prose project-body">
			<Content />
		</div>

		<footer class="post-end" data-pagefind-ignore>
			<a class="arrow-link" href={`${base}projects`}>← All builds</a>
			<a class="arrow-link" href="#_top">Back to top ↑</a>
		</footer>
	</article>
</Layout>

<style>
	.project-body {
		padding-top: 56px;
	}

	.post-end {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 16px;
		max-width: var(--measure);
		margin-top: 72px;
		padding-top: 24px;
		border-top: 1px solid var(--rule);
	}
</style>
