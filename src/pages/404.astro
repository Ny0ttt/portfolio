---
import Layout from "../layouts/Layout.astro";
import { base } from "../utils/url";
---

<Layout title="404" description="This page could not be found." pagefindIgnore>
	<div class="wrap">
		<section class="page-head notfound">
			<p class="label label--accent">ERR-404</p>
			<h1 class="page-title">Nothing at this address.</h1>
			<p class="page-lede">The page moved, or it never existed.</p>
			<p class="links">
				<a class="arrow-link" href={base}>← Home</a>
				<a class="arrow-link" href={`${base}blog`}>Writing</a>
				<a class="arrow-link" href={`${base}projects`}>Projects</a>
			</p>
		</section>
	</div>
</Layout>

<style>
	.notfound {
		border-bottom: 0;
		padding-block: 120px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: 40px;
	}
</style>
