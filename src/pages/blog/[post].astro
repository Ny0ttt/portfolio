---
import "../../styles/prose.css";

import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import MetaGrid from "../../components/MetaGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPosts, readingTime } from "../../utils/content";
import { base } from "../../utils/url";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { post: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);
const subject = post.data.tags.map((t) => t.id).join(" / ") || "—";

const meta = [
	{ label: "Filed", value: formatDate(post.data.createdAt) },
	...(post.data.updatedAt
		? [{ label: "Updated", value: formatDate(post.data.updatedAt) }]
		: []),
	{ label: "Read", value: `${minutes} min` },
	{ label: "Subject", value: subject, wide: subject.length > 40 },
];
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={post.data.image}
	article={{ createdAt: post.data.createdAt, updatedAt: post.data.updatedAt }}
>
	<article class="wrap" data-pagefind-body>
		<header class="page-head" id="_top" data-pagefind-ignore>
			<p class="label label--accent">
				{post.logId}{post.data.draft && " · DRAFT (dev only)"}
			</p>
			<h1 class="page-title">{post.data.title}</h1>
			<p class="page-lede">{post.data.description}</p>
			<MetaGrid items={meta} class="post-meta" />
		</header>

		<div class="post-body">
			{
				sections.length > 0 && (
					<nav class="toc" aria-label="Contents" data-pagefind-ignore>
						<div class="label toc-title">Contents</div>
						<ol>
							{sections.map((h, i) => (
								<li>
									<a href={`#${h.slug}`}>
										<span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}
			<div class="prose">
				<Content />
			</div>
		</div>

		<footer class="post-end" data-pagefind-ignore>
			<a class="arrow-link" href={`${base}blog`}>← All entries</a>
			<a class="arrow-link" href="#_top">Back to top ↑</a>
		</footer>
	</article>
</Layout>

<script>
	// Highlight the section currently being read in the contents list.
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
	const targets = links
		.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);

	if (targets.length > 0) {
		const setActive = () => {
			let current = 0;
			targets.forEach((el, i) => {
				if (el.getBoundingClientRect().top < window.innerHeight * 0.3) current = i;
			});
			links.forEach((a, i) => a.classList.toggle("active", i === current));
		};
		addEventListener("scroll", setActive, { passive: true });
		setActive();
	}
</script>

<style>
	.post-body {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 64px;
		padding-top: 56px;
	}

	.toc {
		flex: 0 0 200px;
		align-self: flex-start;
		position: sticky;
		top: 24px;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.6;
	}

	.toc-title {
		color: var(--text);
		margin-bottom: 10px;
	}

	.toc ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.toc a {
		display: flex;
		gap: 10px;
		color: var(--muted);
		text-decoration: none;
	}

	.toc a.active {
		color: var(--text);
	}

	@media (hover: hover) and (pointer: fine) {
		.toc a:hover {
			color: var(--text);
		}
	}

	.toc a.active .toc-num {
		color: var(--accent);
	}

	.toc-num {
		flex: none;
	}

	.post-body .prose {
		flex: 1 1 560px;
	}

	.post-end {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 16px;
		max-width: calc(var(--measure) + 264px);
		margin-top: 72px;
		padding-top: 24px;
		border-top: 1px solid var(--rule);
	}

	/* Phone: contents list sits above the body and stops being sticky */
	@media (max-width: 900px) {
		.toc {
			position: static;
			flex-basis: 100%;
			padding-bottom: 24px;
			border-bottom: 1px solid var(--rule);
		}
	}
</style>
