---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { base } from "../../utils/url";

const policies = await getCollection("legal");
---

<Layout title="Legal" description="Privacy policies for apps by Rasyid Hamidun." pagefindIgnore>
	<div class="wrap">
		<header class="page-head">
			<p class="label label--accent">Legal · {policies.length} {policies.length === 1 ? "policy" : "policies"}</p>
			<h1 class="page-title">Privacy policies.</h1>
		</header>

		<ul class="list">
			{
				policies.map((policy) => (
					<li>
						<a class="row" href={`${base}legal/${policy.id}`}>
							<span class="row-title">{policy.data.app}</span>
							<span class="row-desc">{policy.data.description}</span>
							<span class="label">Updated {policy.data.lastUpdated}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>

<style>
	.list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-block: 24px;
		border-bottom: 1px solid var(--rule);
		color: var(--text);
		text-decoration: none;
	}

	.row-title {
		font-size: 22px;
		font-weight: 500;
	}

	@media (hover: hover) and (pointer: fine) {
		.row:hover .row-title {
			color: var(--accent);
		}
	}

	.row:active .row-title {
		color: var(--accent);
	}

	.row-desc {
		font-size: 15px;
		color: var(--muted);
	}
</style>
