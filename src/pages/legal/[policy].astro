---
import "../../styles/prose.css";

import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import MetaGrid from "../../components/MetaGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { base } from "../../utils/url";

export const getStaticPaths = (async () => {
	const policies = await getCollection("legal");
	return policies.map((policy) => ({
		params: { policy: policy.id },
		props: { policy },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { policy } = Astro.props;
const { Content } = await render(policy);
const {
	title,
	app,
	company,
	effectiveDate,
	lastUpdated,
	contact,
	location,
	description,
} = policy.data;

const meta = [
	{ label: "App", value: app },
	{ label: "Company", value: company },
	{ label: "Location", value: location },
	{ label: "Contact", value: contact, href: `mailto:${contact}` },
	{ label: "Effective", value: effectiveDate },
	{ label: "Updated", value: lastUpdated },
];
---

<Layout title={title} description={description}>
	<article class="wrap">
		<header class="page-head">
			<p class="label label--accent">Legal · {app}</p>
			<h1 class="page-title">{title}</h1>
			<MetaGrid items={meta} min={180} class="legal-meta" />
		</header>

		<div class="prose no-numbers legal-body">
			<Content />
		</div>

		<footer class="post-end">
			<a class="arrow-link" href={`${base}legal`}>← All policies</a>
		</footer>
	</article>
</Layout>

<style>
	.legal-body {
		padding-top: 56px;
		font-size: 17px;
	}

	.post-end {
		max-width: var(--measure);
		margin-top: 72px;
		padding-top: 24px;
		border-top: 1px solid var(--rule);
	}
</style>
