---
import { openGraph } from "spectre:globals";
import Layout from "../layouts/Layout.astro";
import { getProjects, stackOf } from "../utils/content";
import { base } from "../utils/url";

const projects = await getProjects();
---

<Layout title={openGraph.projects.title || "Projects"} description={openGraph.projects.description} pagefindIgnore>
	<div class="wrap">
		<header class="page-head">
			<p class="label label--accent">[02] Builds · {projects.length} entries</p>
			<h1 class="page-title">Things I've built.</h1>
			<p class="page-lede">Each one starts with the problem it was for. Newest first.</p>
		</header>

		<ol class="index">
			{
				projects.map((project) => (
					<li>
						<a class="row" href={`${base}projects/${project.id}`}>
							<span class="row-id label">{project.buildId}</span>
							<span class="row-year label">{project.data.date.getFullYear()}</span>
							<span class="row-main">
								<span class="row-title">{project.data.title}</span>
								<span class="row-desc">{project.data.description}</span>
							</span>
							<span class="row-stack mono">{stackOf(project)}</span>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</Layout>

<style>
	.index {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: grid;
		grid-template-columns: 64px 64px minmax(0, 1fr) minmax(0, 240px);
		gap: 8px 24px;
		align-items: baseline;
		padding-block: 24px;
		border-bottom: 1px solid var(--rule);
		color: var(--text);
		text-decoration: none;
	}

	.row-title {
		display: block;
		font-size: 22px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
		transition: color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.row:hover .row-title {
			color: var(--accent);
		}
	}

	.row:active .row-title {
		color: var(--accent);
	}

	.row-desc {
		display: block;
		margin-top: 6px;
		font-size: 15px;
		line-height: 1.55;
		color: var(--muted);
	}

	.row-stack {
		font-size: 12px;
		line-height: 1.6;
		color: var(--muted);
		text-align: right;
	}

	@media (max-width: 760px) {
		.row {
			grid-template-columns: auto auto minmax(0, 1fr);
		}

		.row-main {
			grid-column: 1 / -1;
		}

		.row-stack {
			grid-column: 1 / -1;
			text-align: left;
		}
	}
</style>
