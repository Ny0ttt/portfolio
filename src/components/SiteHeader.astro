---
import { name } from "spectre:globals";
import { base } from "../utils/url";

const path = Astro.url.pathname;
const links = [
	{ href: `${base}blog`, label: "/writing" },
	{ href: `${base}projects`, label: "/projects" },
	{ href: `${base}about`, label: "/about" },
];
---

<header class="site-header">
	<nav class="wrap nav" aria-label="Main">
		<a class="brand" href={base}>
			<span class="brand-mark" aria-hidden="true"></span>{name}
		</a>
		<ul class="nav-links">
			{
				links.map((link) => {
					const current = path.startsWith(link.href);
					return (
						<li>
							<a href={link.href} class:list={["nav-cell", { current }]} aria-current={current ? "page" : undefined}>
								{link.label}
							</a>
						</li>
					);
				})
			}
			<li>
				<button type="button" class="nav-cell theme-toggle" aria-label="Toggle dark theme" aria-pressed="false">
					<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
					</svg>
					<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
					</svg>
				</button>
			</li>
			<li>
				<a class="nav-cell nav-contact" href={`${base}about#contact`}>contact ↗</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
	const root = document.documentElement;

	function sync() {
		toggle?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
	}

	toggle?.addEventListener("click", () => {
		const next = root.dataset.theme === "dark" ? "light" : "dark";
		root.dataset.theme = next;
		document.querySelector('meta[name="theme-color"]')?.setAttribute("content", getComputedStyle(root).getPropertyValue("--bg").trim());
		try {
			localStorage.setItem("theme", next);
		} catch {}
		sync();
	});

	sync();
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--rule);
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 13px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		padding-block: 18px;
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.brand-mark {
		width: 10px;
		height: 10px;
		background: var(--accent);
		flex: none;
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-cell {
		display: flex;
		align-items: center;
		min-height: 54px;
		padding: 0 20px;
		border: 0;
		border-left: 1px solid var(--rule);
		background: transparent;
		color: var(--muted);
		text-decoration: none;
		cursor: pointer;
	}

	.nav-links li:last-child .nav-cell {
		border-right: 1px solid var(--rule);
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-cell:hover {
			color: var(--text);
			background: var(--surface);
		}
	}

	.nav-cell:active {
		background: var(--surface);
		color: var(--text);
	}

	.nav-cell.current {
		color: var(--text);
		background: var(--surface);
	}

	.nav-contact {
		color: var(--accent);
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-contact:hover {
			color: var(--accent);
		}
	}

	.icon-sun {
		display: none;
	}

	:global([data-theme="dark"]) .icon-sun {
		display: block;
	}

	:global([data-theme="dark"]) .icon-moon {
		display: none;
	}

	/* Phone: brand on its own row, nav cells share the second row */
	@media (max-width: 640px) {
		.nav {
			padding-inline: 0;
		}

		.brand {
			width: 100%;
			padding-inline: var(--gutter);
			border-bottom: 1px solid var(--rule);
		}

		.nav-links {
			width: 100%;
		}

		.nav-links li {
			flex: 1 1 auto;
		}

		.nav-cell {
			justify-content: center;
			min-height: 48px;
			padding: 0 10px;
			font-size: 12px;
			white-space: nowrap;
		}

		.nav-links li:first-child .nav-cell {
			border-left: 0;
		}

		.nav-links li:last-child .nav-cell {
			border-right: 0;
		}
	}
</style>
